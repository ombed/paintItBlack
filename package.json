{
  "name": "paintitblack-tests",
  "version": "1.0.0",
  "description": "Browser checks for the redaction tool",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node tests/run.js && playwright test",
    "test:unit": "node tests/run.js",
    "test:browser": "playwright test",
    "build:fixtures": "node tests/build-fixtures.js",
    "build:design": "node scripts/build-design.js",
    "report": "node tests/report.js",
    "bench": "node bench/generate.js && node bench/run.js",
    "bench:nomodel": "node bench/generate.js && node bench/run.js --no-model",
    "gate": "node bench/gate.js",
    "bump": "node scripts/bump.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github-new:ombed/paintItBlack.git"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": true,
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@xmldom/xmldom": "^0.9.12",
    "jsdom": "^30.0.1"
  }
}
